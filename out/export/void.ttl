    void:vocabulary <https://bibleontology.org/ns/meaning#> ;
    void:dataDump <https://github.com/bibleontology/bibleontology/raw/main/out/export/entities.ttl.gz> ;
    dcat:distribution [ a dcat:Distribution ; dcterms:title "entities.ttl.gz" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:compressFormat <https://www.iana.org/assignments/media-types/application/gzip> ; dcat:downloadURL <https://github.com/bibleontology/bibleontology/raw/main/out/export/entities.ttl.gz> ] .

