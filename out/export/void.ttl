    void:vocabulary <https://bibleontology.org/ns/claim#>, <https://bibleontology.org/ns/relation#>, <http://www.w3.org/ns/prov#> ;
    void:dataDump <https://github.com/bibleontology/bibleontology/raw/main/out/export/claims.trig.gz> ;
    dcat:distribution [ a dcat:Distribution ; dcterms:title "claims.trig.gz" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/trig> ; dcat:compressFormat <https://www.iana.org/assignments/media-types/application/gzip> ; dcat:downloadURL <https://github.com/bibleontology/bibleontology/raw/main/out/export/claims.trig.gz> ] .

<https://bibleontology.org/dataset/entities> a void:Dataset, dcat:Dataset ;
    dcterms:title "Records, typed" ;
    dcterms:description "Each record's address and name, and its class where one maps." ;
    dcterms:isPartOf <https://bibleontology.org/dataset> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "© 2026 Doug Egge. Licensed under CC BY 4.0: share and adapt, with credit to Bible Ontology by Doug Egge (bibleontology.org)." ;
