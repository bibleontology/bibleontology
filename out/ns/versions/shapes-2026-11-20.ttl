# Bible Ontology -- SHACL shapes, version 1.7.0 (2026-11-20).
# Closed-world checks for the graph: what the vocabularies at /ns/meaning, /ns/structure
# and /ns/relation describe, checked here rather than inferred. Run with inference off.
# (c) 2026 Doug Egge. Licensed under CC BY 4.0: share and adapt, with credit to Bible Ontology by Doug Egge (bibleontology.org).
# Licence: https://creativecommons.org/licenses/by/4.0/
@prefix biblio: <https://bibleontology.org/ns/biblio#> .
@prefix bom: <https://bibleontology.org/ns/meaning#> .
@prefix bor: <https://bibleontology.org/ns/relation#> .
@prefix bos: <https://bibleontology.org/ns/structure#> .
@prefix bosh: <https://bibleontology.org/ns/meaning/shapes#> .
@prefix bow: <https://bibleontology.org/ns/word#> .
@prefix bsh: <https://bibleontology.org/ns/biblio/shapes#> .
@prefix claim: <https://bibleontology.org/ns/claim#> .
@prefix csh: <https://bibleontology.org/ns/claim/shapes#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bsh:ArrangementEntryShape a sh:NodeShape ;
    sh:property [ sh:class lrmoo:F1_Work ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path biblio:member ],
        [ sh:class biblio:Arrangement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path biblio:inArrangement ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path biblio:position ],
        [ sh:class biblio:Section ;
            sh:maxCount 1 ;
            sh:path biblio:inSection ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path biblio:positionInSection ] ;
    sh:sparql [ sh:message "An entry's section divides the entry's own arrangement, and its position falls inside the section." ;
            sh:prefixes bsh:prefixes ;
            sh:select """SELECT $this ?sec WHERE {
            $this biblio:inSection ?sec ; biblio:inArrangement ?arr ; biblio:position ?p .
            ?sec biblio:firstPosition ?f ; biblio:lastPosition ?l .
            OPTIONAL { ?sec biblio:sectionOf ?of . }
            FILTER (!BOUND(?of) || ?of != ?arr || ?p < ?f || ?p > ?l)
        }""" ] ;
    sh:targetClass biblio:ArrangementEntry .

bsh:ArrangementShape a sh:NodeShape ;
    sh:property [ sh:class lrmoo:F1_Work ;
            sh:maxCount 1 ;
            sh:message "An arrangement orders exactly one collection." ;
            sh:minCount 1 ;
            sh:path biblio:arrangementOf ],
        [ sh:message "An arrangement says whose order it is." ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass biblio:Arrangement .

bsh:ExpressionShape a sh:NodeShape ;
    sh:property [ sh:class lrmoo:F1_Work ;
            sh:maxCount 1 ;
            sh:message "An Expression realises exactly one Work." ;
            sh:minCount 1 ;
            sh:path [ sh:inversePath lrmoo:R3_is_realised_in ] ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "An Expression has exactly one language: a second language is a second Expression." ;
            sh:minCount 1 ;
            sh:path dcterms:language ],
        [ sh:class lrmoo:F2_Expression ;
            sh:maxCount 1 ;
            sh:message "A translation is made from one Expression." ;
            sh:path biblio:translationOf ],
        [ sh:class lrmoo:F2_Expression ;
            sh:path lrmoo:R75_incorporates ] ;
    sh:sparql [ sh:message "A translation realises the same Work as its source: a translation is never a new Work." ;
            sh:prefixes bsh:prefixes ;
            sh:select """SELECT $this ?src WHERE {
            $this biblio:translationOf ?src .
            FILTER NOT EXISTS { ?w lrmoo:R3_is_realised_in $this , ?src . }
        }""" ],
        [ sh:message "An Expression incorporates another only where that one realises a different Work (LRMoo R75); a part of the same Work is not incorporated." ;
            sh:prefixes bsh:prefixes ;
            sh:select """SELECT $this ?inner WHERE {
            $this lrmoo:R75_incorporates ?inner .
            ?w lrmoo:R3_is_realised_in $this , ?inner .
        }""" ] ;
    sh:targetClass lrmoo:F2_Expression .

bsh:ManifestationShape a sh:NodeShape ;
    sh:property [ sh:class lrmoo:F2_Expression ;
            sh:message "A Manifestation embodies at least one Expression." ;
            sh:minCount 1 ;
            sh:path lrmoo:R4_embodies ],
        [ sh:message "A Manifestation links where it is published." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcterms:source ] ;
    sh:targetClass lrmoo:F3_Manifestation .

bsh:SectionShape a sh:NodeShape ;
    sh:property [ sh:class biblio:Arrangement ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path biblio:sectionOf ],
        [ sh:datatype xsd:integer ;
            sh:lessThanOrEquals biblio:lastPosition ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path biblio:firstPosition ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path biblio:lastPosition ],
        [ sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass biblio:Section .

bsh:SegmentShape a sh:NodeShape ;
    sh:property [ sh:class lrmoo:F2_Expression ;
            sh:maxCount 1 ;
            sh:message "A segment is one Expression's: two texts never share a verse." ;
            sh:minCount 1 ;
            sh:path biblio:segmentOf ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path biblio:segmentNumber ],
        [ sh:class biblio:Segment ;
            sh:path biblio:alignedWith ] ;
    sh:sparql [ sh:message "Aligned segments are verses of two Expressions of the same Work." ;
            sh:prefixes bsh:prefixes ;
            sh:select """SELECT $this ?other WHERE {
            $this biblio:alignedWith ?other ; biblio:segmentOf ?a .
            ?other biblio:segmentOf ?b .
            FILTER (?a = ?b || NOT EXISTS { ?w lrmoo:R3_is_realised_in ?a , ?b . })
        }""" ] ;
    sh:targetClass biblio:Segment .

bsh:WorkCreationShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lrmoo:F1_Work ;
            sh:message "A creation event says what it created, and nothing the text does not give: no agent, date or place." ;
            sh:minCount 1 ;
            sh:path lrmoo:R16_created ] ;
    sh:targetClass lrmoo:F27_Work_Creation .

bsh:WorkShape a sh:NodeShape ;
    sh:not [ sh:or ( [ sh:class lrmoo:F2_Expression ] [ sh:class lrmoo:F3_Manifestation ] [ sh:class biblio:Section ] [ sh:class biblio:Segment ] [ sh:class biblio:Arrangement ] ) ] ;
    sh:property [ sh:languageIn ( "en" ) ;
            sh:message "A Work has an English label." ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class lrmoo:F2_Expression ;
            sh:message "A Work is realised in at least one Expression: a Work is not its text, and has one." ;
            sh:minCount 1 ;
            sh:path lrmoo:R3_is_realised_in ],
        [ sh:class lrmoo:F27_Work_Creation ;
            sh:maxCount 1 ;
            sh:message "A Work has exactly one creation event (LRMoo R16: necessary, one)." ;
            sh:minCount 1 ;
            sh:path [ sh:inversePath lrmoo:R16_created ] ],
        [ sh:maxCount 0 ;
            sh:message "Who composed a Work is a reading: a claim, never a plain triple." ;
            sh:path biblio:composedBy ],
        [ sh:maxCount 0 ;
            sh:message "What a heading names is a reading: a claim, never a plain triple." ;
            sh:path biblio:superscriptionNames ] ;
    sh:sparql [ sh:message "A collected Work is incorporated by its collection's Expression, never one of its parts (R67 is for parts conceived together as one whole)." ;
            sh:prefixes bsh:prefixes ;
            sh:select """SELECT $this ?part WHERE {
            $this lrmoo:R67_has_part ?part .
            ?entry biblio:member ?part ; biblio:inArrangement ?arr .
            ?arr biblio:arrangementOf $this .
        }""" ] ;
    sh:targetClass lrmoo:F1_Work .

csh:ClaimShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A claim has exactly one subject." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:subject ],
        [ sh:maxCount 1 ;
            sh:message "A claim names the voice its triple is stated in." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:voice ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path claim:readBy ],
        [ sh:maxCount 1 ;
            sh:message "A claim has exactly one relation, from /ns/relation, claim:says for a reporting speaker's claim, or a heading's reading from /ns/biblio." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:relation ;
            sh:pattern "^https://bibleontology.org/ns/(relation#|claim#says$|biblio#(composedBy|superscriptionNames)$)" ],
        [ sh:maxCount 1 ;
            sh:message "A claim has exactly one object." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:object ],
        [ sh:message "A claim rests on at least one verse, each the site's page for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:verse ;
            sh:pattern "^https://bibleontology.org/p/[0-9A-Za-z]+\\.[0-9]+\\.[0-9]+$" ],
        [ sh:in ( claim:explicit claim:implied claim:conjectured claim:disputed ) ;
            sh:maxCount 1 ;
            sh:message "A claim carries one step of the certainty scale." ;
            sh:minCount 1 ;
            sh:path claim:certainty ] ;
    sh:targetClass claim:Claim .

csh:StatementShape a sh:NodeShape ;
    sh:property [ sh:in ( claim:modality_stated claim:modality_nonfinite claim:modality_commanded claim:modality_commanded_or_wished claim:modality_promised claim:modality_foretold claim:modality_urged claim:modality_wished claim:modality_asked ) ;
            sh:maxCount 1 ;
            sh:message "A verb statement carries one force from the modalities scheme." ;
            sh:minCount 1 ;
            sh:path claim:modality ],
        [ sh:in ( claim:family_verb_body claim:family_verb_change claim:family_verb_cognition claim:family_verb_communication claim:family_verb_competition claim:family_verb_consumption claim:family_verb_contact claim:family_verb_creation claim:family_verb_emotion claim:family_verb_motion claim:family_verb_perception claim:family_verb_possession claim:family_verb_social claim:family_verb_stative claim:family_verb_weather ) ;
            sh:maxCount 1 ;
            sh:message "A verb statement's family, where it has one, is from the verb families scheme." ;
            sh:path claim:family ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "A verb statement says whether its clause is negated." ;
            sh:minCount 1 ;
            sh:path claim:negated ],
        [ sh:maxCount 1 ;
            sh:message "A verb statement's verb is a word page." ;
            sh:nodeKind sh:IRI ;
            sh:path claim:verb ;
            sh:pattern "^https://bibleontology.org/word/[hg][0-9]+$" ],
        [ sh:message "A clause is addressed by its verse, in the verse pages' book codes, and its id within the verse." ;
            sh:nodeKind sh:IRI ;
            sh:path claim:clause ;
            sh:pattern "^https://bibleontology.org/structure/(Gen|Exod|Lev|Num|Deut|Josh|Judg|Ruth|1Sam|2Sam|1Kgs|2Kgs|1Chr|2Chr|Ezra|Neh|Esth|Job|Ps|Prov|Eccl|Song|Isa|Jer|Lam|Ezek|Dan|Hos|Joel|Amos|Obad|Jonah|Mic|Nah|Hab|Zeph|Hag|Zech|Mal|Matt|Mark|Luke|John|Acts|Rom|1Cor|2Cor|Gal|Eph|Phil|Col|1Thess|2Thess|1Tim|2Tim|Titus|Phlm|Heb|Jas|1Pet|2Pet|1John|2John|3John|Jude|Rev)\\.[0-9]+\\.[0-9]+#[a-z]+[0-9]+$" ] ;
    sh:targetSubjectsOf claim:verbLabel .

bosh:Classification a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:classifies ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:inClass ],
        [ sh:minCount 1 ;
            sh:path bom:statement ],
        [ sh:minCount 1 ;
            sh:path bom:saidBy ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:Classification .

bosh:ContestedHasBothSides a sh:NodeShape ;
    sh:sparql [ sh:message "A use the text itself settles (a figure with a stated tenor) is not contested." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            SELECT $this WHERE {\r
                $this bom:usage bom:Contested .\r
                ?f bom:figureAt $this ; bom:tenorBasis "stated" .\r
            }""" ],
        [ sh:message "A contested use needs at least two usage readings that answer differently." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            SELECT $this WHERE {\r
                $this bom:usage bom:Contested .\r
                FILTER NOT EXISTS {\r
                    ?a bom:readsUsageOf $this ; bom:readsUsage ?ua .\r
                    ?b bom:readsUsageOf $this ; bom:readsUsage ?ub .\r
                    FILTER (?ua != ?ub)\r
                }\r
            }""" ] ;
    sh:targetClass bow:Occurrence .

bosh:FigurativeHasFigure a sh:NodeShape ;
    sh:sparql [ sh:message "Usage is figurative (or a sign), but no FigurativeUse is at this occurrence." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            SELECT $this WHERE {\r
                $this bom:usage ?u .\r
                FILTER (?u IN (bom:Figurative, bom:Sign))\r
                FILTER NOT EXISTS { ?f bom:figureAt $this }\r
            }""" ] ;
    sh:targetClass bow:Occurrence .

bosh:FigurativeUse a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:figureAt ],
        [ sh:class bow:Sense ;
            sh:maxCount 1 ;
            sh:message "A figure names its image (the vehicle) as a sense." ;
            sh:minCount 1 ;
            sh:path bom:vehicle ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:mode ],
        [ sh:message "A figure says what in the text marks it." ;
            sh:minCount 1 ;
            sh:path bom:marker ],
        [ sh:in ( "stated" "read" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:tenorBasis ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:FigurativeUse .

bosh:MembershipIsArgued a sh:NodeShape ;
    sh:sparql [ sh:message "A member of Human, Deity, HeavenlyBeing or Spirit with no Classification citing why." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            SELECT $this ?c WHERE {\r
                $this a ?c .\r
                FILTER (?c IN (bom:Human, bom:Deity, bom:HeavenlyBeing, bom:Spirit))\r
                FILTER NOT EXISTS {\r
                    ?k bom:classifies $this ; bom:inClass ?c ; bom:evidence ?v .\r
                }\r
            }""" ] ;
    sh:targetClass bom:Individual .

bosh:Occurrence a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An occurrence has exactly one lexeme." ;
            sh:minCount 1 ;
            sh:path bow:ofLexeme ],
        [ sh:maxCount 1 ;
            sh:message "An occurrence carries at most one sense (or none, where the evidence does not decide)." ;
            sh:path bow:inSense ],
        [ sh:in ( bom:Literal bom:Figurative bom:Unmarked bom:Sign bom:Contested ) ;
            sh:maxCount 1 ;
            sh:message "Usage is literal, figurative, a sign, contested, or unmarked — one of them." ;
            sh:path bom:usage ] ;
    sh:targetClass bow:Occurrence .

bosh:OneTopClass a sh:NodeShape ;
    sh:sparql [ sh:message "An individual carries more than one top class; keep the least disputed and move the rest to predications." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r
            SELECT $this WHERE {\r
                $this a ?c1, ?c2 .\r
                FILTER (?c1 != ?c2)\r
                FILTER (?c1 IN (bom:PersonalBeing, bom:Group, bom:Animal,\r
                    bom:Plant, bom:Artifact, bom:BodyPart, bom:Food,\r
                    bom:Substance, bom:NaturalObject, bom:Place, bom:Time,\r
                    bom:Event, bom:Act, bom:State, bom:Phenomenon,\r
                    bom:Feeling, bom:Cognition, bom:Communication,\r
                    bom:Attribute, bom:Quantity, bom:Possession,\r
                    bom:Relation, bom:Shape, bom:Motive))\r
                FILTER (?c2 IN (bom:PersonalBeing, bom:Group, bom:Animal,\r
                    bom:Plant, bom:Artifact, bom:BodyPart, bom:Food,\r
                    bom:Substance, bom:NaturalObject, bom:Place, bom:Time,\r
                    bom:Event, bom:Act, bom:State, bom:Phenomenon,\r
                    bom:Feeling, bom:Cognition, bom:Communication,\r
                    bom:Attribute, bom:Quantity, bom:Possession,\r
                    bom:Relation, bom:Shape, bom:Motive))\r
            }""" ] ;
    sh:targetClass bom:Individual .

bosh:Predication a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path bom:predicatedCategory ] [ sh:minCount 1 ;
                sh:path bom:predicatedIdentity ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:predicationOf ],
        [ sh:message "The saying is the fact: a predication names who says it." ;
            sh:minCount 1 ;
            sh:path bom:saidBy ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:Predication .

bosh:Reading a sh:NodeShape ;
    sh:property [ sh:message "A reading always names its reader." ;
            sh:minCount 1 ;
            sh:path prov:wasAttributedTo ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:Reading .

bosh:SenseProvenance a sh:NodeShape ;
    sh:property [ sh:message "A sense says how it was reached ('English' via a gloss)." ;
            sh:minCount 1 ;
            sh:path bom:derivedVia ] ;
    sh:targetClass bow:Sense .

bosh:ShownCardWord a sh:NodeShape ;
    sh:property [ sh:hasValue bom:default ;
            sh:message "A shown card word is shown by default under the filter policy." ;
            sh:path bom:tier ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An anchored word under the policy's cut (0.15) is shown." ;
            sh:prefixes [ sh:declare [ sh:namespace "https://bibleontology.org/ns/meaning#"^^xsd:anyURI ;
                            sh:prefix "bom" ],
                        [ sh:namespace "http://www.w3.org/ns/dqv#"^^xsd:anyURI ;
                            sh:prefix "dqv" ] ] ;
            sh:select """SELECT $this WHERE { $this bom:wordBasis "anchored" ;\r
            dqv:hasQualityMeasurement [ dqv:isMeasurementOf bom:cardWordShare ; dqv:value ?v ] .\r
            FILTER (?v < 0.15) }""" ] ;
    sh:targetClass bom:CardWord .

bosh:SignIsStated a sh:NodeShape ;
    sh:sparql [ sh:message "A sign whose meaning is not stated by the text is a reading, not a sign." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            SELECT $this WHERE {\r
                $this bom:usage bom:Sign .\r
                FILTER NOT EXISTS { ?f bom:figureAt $this ; bom:tenorBasis "stated" }\r
            }""" ] ;
    sh:targetClass bow:Occurrence .

bosh:TenorFollowsBasis a sh:NodeShape ;
    sh:sparql [ sh:message "A figure whose tenor is 'read' carries the tenor itself; it must be on a SymbolReading with a named reader." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            SELECT $this WHERE { $this bom:tenorBasis "read" ; bom:tenor ?t . }""" ],
        [ sh:message "A figure whose tenor is 'stated' names it." ;
            sh:select """\r
            PREFIX bom: <https://bibleontology.org/ns/meaning#>\r
            SELECT $this WHERE { $this bom:tenorBasis "stated" .\r
                                 FILTER NOT EXISTS { $this bom:tenor ?t } }""" ] ;
    sh:targetClass bom:FigurativeUse .

bosh:UsageReading a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:readsUsageOf ],
        [ sh:in ( bom:Literal bom:Figurative bom:Sign ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:readsUsage ],
        [ sh:minCount 1 ;
            sh:path bom:readsAs ] ;
    sh:targetClass bom:UsageReading .

bor:accused_objectShape a sh:NodeShape ;
    sh:message "The object of accused must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:accused .

bor:accused_subjectShape a sh:NodeShape ;
    sh:message "The subject of accused must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:accused .

bor:acted_in_subjectShape a sh:NodeShape ;
    sh:message "The subject of acted_in must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:acted_in .

bor:ancestor_of_objectShape a sh:NodeShape ;
    sh:message "The object of ancestor_of must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:ancestor_of .

bor:ancestor_of_subjectShape a sh:NodeShape ;
    sh:message "The subject of ancestor_of must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:ancestor_of .

bor:anointed_subjectShape a sh:NodeShape ;
    sh:message "The subject of anointed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:anointed .

bor:answered_in_subjectShape a sh:NodeShape ;
    sh:message "The subject of answered_in must be one of: Image, Saying" ;
    sh:or ( [ sh:class bom:Image ] [ sh:class bom:Saying ] ) ;
    sh:targetSubjectsOf bor:answered_in .

bor:answered_objectShape a sh:NodeShape ;
    sh:message "The object of answered must be one of: Animal, Group, PersonalBeing, Saying" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Saying ] ) ;
    sh:targetObjectsOf bor:answered .

bor:answered_subjectShape a sh:NodeShape ;
    sh:message "The subject of answered must be one of: Group, PersonalBeing, Saying" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Saying ] ) ;
    sh:targetSubjectsOf bor:answered .

bor:appeared_to_objectShape a sh:NodeShape ;
    sh:message "The object of appeared_to must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:appeared_to .

bor:appeared_to_subjectShape a sh:NodeShape ;
    sh:message "The subject of appeared_to must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:appeared_to .

bor:appointed_objectShape a sh:NodeShape ;
    sh:message "The object of appointed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:appointed .

bor:appointed_subjectShape a sh:NodeShape ;
    sh:message "The subject of appointed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:appointed .

bor:ascribed_to_objectShape a sh:NodeShape ;
    sh:message "The object of ascribed_to must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
