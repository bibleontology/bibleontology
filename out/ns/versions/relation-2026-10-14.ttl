bor:present_with a owl:ObjectProperty ;
    rdfs:label "is with" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A being, person, group or concept is with a person, group, being or concept, where the text states the presence in so many words." ;
