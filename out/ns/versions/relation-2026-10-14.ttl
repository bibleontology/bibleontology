    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group sends another away to end a marriage, in the text's own word and not in a later legal term such as divorce." ;
    bor:category "Marriage & union" ;
    bor:inverseLabel "was sent away by" ;
