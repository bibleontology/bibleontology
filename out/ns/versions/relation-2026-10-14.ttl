    bor:inverseLabel "was sent by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "being",
        "creature",
        "group",
        "person" .

bor:servant_of a owl:ObjectProperty ;
    rdfs:label "served" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, group or concept serves a person, group or being; the relation covers officials, armour-bearers, stewards and slaves alike, since the text rarely separates them." ;
    bor:category "Service & authority" ;
    bor:inverseLabel "was served by" ;
    bor:sourceKind "concept",
        "group",
        "person" ;
    bor:targetKind "being",
        "group",
        "person" .

bor:sibling_of a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is a sibling of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "Two people are siblings, full or unspecified; the relation reads the same from either side." ;
    bor:category "Kinship" .

bor:signifies a owl:ObjectProperty ;
    rdfs:label "signifies" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "The text states outright what a thing stands for; it records the key the text gives and not a reader's decision about what something means, and it does not carry over to other uses of the same word." ;
    bor:category "Things" ;
    bor:inverseLabel "is signified by" ;
    bor:sourceKind "concept",
        "creature",
        "group",
        "image",
        "object",
        "observance",
        "person",
        "place" ;
    bor:targetKind "being",
        "covenant",
        "creature",
        "group",
        "object",
        "observance",
        "person",
        "place",
        "text",
        "title" .

bor:sourceKind a owl:AnnotationProperty ;
    rdfs:label "the kind of record a relation starts from" .

bor:speaks_of a owl:ObjectProperty ;
    rdfs:label "speaks of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A statement, title, image or verdict makes a claim about the thing it names; the statement is the source with the verse behind it, and nothing runs the other way." ;
    bor:category "Concepts" ;
    bor:inverseLabel "is spoken of in" ;
    bor:sourceKind "assessment",
        "image",
        "text",
        "title" ;
    bor:targetKind "assessment",
        "being",
        "concept",
        "covenant",
        "creature",
        "group",
        "image",
        "object",
        "observance",
        "person",
        "place",
        "text",
        "title" .

bor:specializes a owl:ObjectProperty ;
    rdfs:label "is a narrower form of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "One form is a narrower form of a broader form; both are forms and neither is an occurrence, and the grouping is the graph's own and not a statement of the text." ;
    bor:category "Patterns" ;
    bor:sourceKind "pattern" ;
    bor:targetKind "pattern" .

bor:spoken_in a owl:ObjectProperty ;
    rdfs:label "is spoken in" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A kind of message is spoken within a pattern, concept, event or passage; it is supported by the verses the message and the other node share, and not by the names sounding alike." ;
    bor:category "Language" ;
    bor:inverseLabel "has spoken in it" ;
    bor:sourceKind "pattern" ;
    bor:targetKind "concept",
        "event",
        "passage",
        "pattern" .

bor:spoken_of_as a owl:ObjectProperty ;
    rdfs:label "is spoken of as" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "The text applies the name or nature of one person or being to another; the edge says only that a particular verse says so, and it is not a claim that the two are the same." ;
    bor:category "Father, Son & Spirit" ;
    bor:inverseLabel "is a name the text gives to" ;
    bor:sourceKind "being",
        "person" ;
    bor:targetKind "being",
        "person" .

bor:spouse_of a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is married to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "Two people are married to each other; the relation reads the same from either side." ;
    bor:category "Marriage & union" .

bor:stationed_at a owl:ObjectProperty ;
    rdfs:label "was stationed at" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A being or creature is posted at a place or object and left there; it records the placement and not residence or purpose." ;
    bor:category "Places" ;
    bor:inverseLabel "had stationed at it" ;
    bor:sourceKind "being",
        "creature" ;
    bor:targetKind "object",
        "place" .

bor:supersedes a owl:ObjectProperty ;
    rdfs:label "makes obsolete" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "One covenant is said by the text to make an earlier covenant obsolete; it is recorded only where the text says so." ;
    bor:category "Covenants" ;
    bor:inverseLabel "was made obsolete by" ;
    bor:sourceKind "covenant" ;
    bor:targetKind "covenant" .

bor:takes_up a owl:ObjectProperty ;
    rdfs:label "takes up the words of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A later account quotes, summarises or gathers the words given in an earlier one; the pairs of words are the evidence and no likeness between persons is claimed." ;
    bor:category "Story echoes" ;
    bor:inverseLabel "has its words taken up in" ;
    bor:sourceKind "event",
        "passage",
        "text" ;
    bor:targetKind "event",
        "passage",
        "text" .

bor:targetKind a owl:AnnotationProperty ;
    rdfs:label "the kind of record a relation points to" .

bor:titled a owl:ObjectProperty ;
    rdfs:label "is called" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or being is called by a title that the text gives; the title is its own entity, kept apart from the creature or object it is built from." ;
    bor:category "Images & figures" ;
    bor:inverseLabel "is a title of" ;
    bor:sourceKind "being",
        "person" ;
    bor:targetKind "title" .

bor:token_of a owl:ObjectProperty ;
    rdfs:label "is the sign of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "An object, observance, creature or place is named by the text as the sign of a covenant." ;
    bor:category "Covenants" ;
    bor:inverseLabel "is signified by" ;
    bor:sourceKind "creature",
        "object",
        "observance",
        "place" ;
    bor:targetKind "covenant" .

bor:told a owl:ObjectProperty ;
    rdfs:label "told" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, being or group gives a parable, dream or vision, the one the figure belongs to; it is not the one who wrote it down." ;
    bor:category "Encounters & speech" ;
    bor:inverseLabel "was told by" ;
    bor:sourceKind "being",
        "concept",
        "creature",
        "group",
        "person" ;
    bor:targetKind "person",
        "text" .

bor:took a owl:ObjectProperty ;
    rdfs:label "took" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, being or group takes something from another or from its place; the counterpart of giving." ;
    bor:category "Encounters & speech" ;
    bor:inverseLabel "was taken by" ;
    bor:sourceKind "being",
        "concept",
        "group",
        "person" ;
    bor:targetKind "being",
        "concept",
        "creature",
        "group",
        "object",
        "person",
        "place" .

bor:traveled_to a owl:ObjectProperty ;
    rdfs:label "went to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group went to a place on a journey the narrative marks; it is deliberately a weak tie." ;
    bor:category "Places" ;
    bor:inverseLabel "was visited by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "place" .

bor:uncle_of a owl:ObjectProperty ;
    rdfs:label "is the uncle/aunt of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person is the uncle or aunt of another, recorded where the text states it and not where it follows from two named parents and a sibling." ;
    bor:category "Kinship" ;
    bor:inverseLabel "is the nephew/niece of" .

bor:warned a owl:ObjectProperty ;
    rdfs:label "warned" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, being or group gives another notice of danger or of a consequence to come." ;
    bor:category "Encounters & speech" ;
    bor:inverseLabel "was warned by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:wore a owl:ObjectProperty ;
    rdfs:label "wore" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group wears a garment or piece of dress the text puts on them; it is not the same as carrying the garment and says nothing of who had the right to wear it." ;
    bor:category "Things" ;
    bor:inverseLabel "was worn by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "object" .

bor:wrote_letter_to a owl:ObjectProperty ;
    rdfs:label "wrote to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person wrote to another person, taken from the address of the letter itself." ;
    bor:category "Association" ;
    bor:inverseLabel "received a letter from" ;
    bor:sourceKind "person" ;
    bor:targetKind "person" .

bor:wrote_to a owl:ObjectProperty ;
    rdfs:label "wrote to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person wrote to a congregation, taken from the address of the letter itself; the target is the group and not the town where it met." ;
    bor:category "Peoples & groups" ;
    bor:inverseLabel "received a letter from" ;
    bor:sourceKind "person" ;
    bor:targetKind "group" .

<https://bibleontology.org/ns/relation> a owl:Ontology ;
    rdfs:label "Bible Ontology — relations" ;
    dcterms:created "2026-10-11"^^xsd:date ;
    dcterms:creator "Doug Egge" ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    dcterms:rights "© 2026 Doug Egge. All rights reserved." ;
    dcterms:title "Bible Ontology — relations" ;
    vann:preferredNamespacePrefix "bor" ;
    vann:preferredNamespaceUri "https://bibleontology.org/ns/relation#" ;
    rdfs:comment "Reasoning policy. These terms describe the graph; they are not built for automated inference over it. Every relation in the graph is a claim that carries its verse, its certainty and, where someone in the text says it, its speaker, and a reasoner that ignores those turns a character's claim into the narrator's or a reading into a fact. So: no owl:sameAs between records (possibly_same_as and spoken_of_as are readings and names, never identities); no functional or inverse-functional kinship (the accounts name more than one father or mother for some people, and the graph keeps both); no transitive chaining of images, figures, symbols or places; and no rule of any kind concerning God, the Father, Jesus or the Holy Spirit. Constraints are checked, closed-world, by the SHACL shapes at https://bibleontology.org/ns/shapes, not inferred.",
        "The controlled vocabulary of relations the Bible Ontology graph may assert: each reads '<source> <label> <target>', and every relation in the graph uses one of these types. Companion to https://bibleontology.org/ns/meaning.",
        "Versioning. A term's address never changes and is never reused. A term whose meaning changes gets a new address, and the old one is marked owl:deprecated with dcterms:isReplacedBy. Additions raise the minor version; a change of meaning raises the major. Each release is kept forever at its dated version IRI; the undated address serves the latest." ;
    owl:versionIRI <https://bibleontology.org/ns/relation/2026-10-14> ;
    owl:versionInfo "1.0.0" .

