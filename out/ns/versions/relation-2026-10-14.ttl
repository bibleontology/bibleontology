@prefix bor: <https://bibleontology.org/ns/relation#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bor:accused a owl:ObjectProperty ;
    rdfs:label "accused" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group lays a charge against another person or group; it is the complaint made, not a plot against someone and not the verdict." ;
    bor:category "Conflict" ;
    bor:inverseLabel "was accused by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:adoptive_parent_of a owl:ObjectProperty ;
    rdfs:label "raised / adopted" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person who becomes a parent of another through a willful, formal process of adoption." ;
    bor:category "Kinship" ;
    bor:inverseLabel "was raised by" .

bor:ally_of a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "was allied with" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "Two parties were allied politically or militarily; the relation reads the same from either side and is not a mere friendship." ;
    bor:category "Association" .

bor:ancestor_of a owl:ObjectProperty ;
    rdfs:label "is an ancestor of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group is an ancestor of another across more than one generation, or without the intervening generations being given, including a people traced to a named ancestor." ;
    bor:category "Descent (non-parent)" ;
    bor:inverseLabel "is a descendant of" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:anointed a owl:ObjectProperty ;
    rdfs:label "anointed" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group anoints a person, as the text records it; a body of people can confer the office as well as a prophet." ;
    bor:category "Prophetic & priestly" ;
    bor:inverseLabel "was anointed by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "person" .

bor:answered a owl:ObjectProperty ;
    rdfs:label "answered" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "One speech replies to another, or a person replies to a speech or a person; where the text has a speaker answer the previous speech, the reply is to what was said and not only to the one who said it." ;
    bor:category "Language" ;
    bor:inverseLabel "was answered by" ;
    bor:sourceKind "being",
        "group",
        "person",
        "text" ;
    bor:targetKind "being",
        "creature",
        "group",
        "person",
        "text" .

bor:appeared_to a owl:ObjectProperty ;
    rdfs:label "appeared to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A being, person or group appears to a person or group in a visitation the text narrates, without classifying it as a vision, a dream or a bodily appearance." ;
    bor:category "Encounters & speech" ;
    bor:inverseLabel "was visited by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:appointed a owl:ObjectProperty ;
    rdfs:label "appointed / installed" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, group or being places a person or group in an office or command." ;
    bor:category "Rule & succession" ;
    bor:inverseLabel "was appointed by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:ascribed_to a owl:ObjectProperty ;
    rdfs:label "is ascribed to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A writing carries a superscription naming a person or group; the edge records the ascription as it is printed and does not say whether it means authorship, dedication or subject." ;
    bor:category "Language" ;
    bor:inverseLabel "has ascribed to them" ;
    bor:sourceKind "text" ;
    bor:targetKind "group",
        "person" .

bor:aspect_of a owl:ObjectProperty ;
    rdfs:label "is an aspect of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A concept or pattern is one facet of a broader idea, joined to it and not merged into it; the grouping is the map's and not the text's, and each aspect is described by the passages it cites." ;
    bor:category "Concepts" ;
    bor:inverseLabel "has as an aspect" ;
    bor:sourceKind "concept",
        "pattern" ;
    bor:targetKind "being",
        "concept",
        "covenant",
        "group",
        "image",
        "object",
        "observance",
        "person",
        "place",
        "title" .

bor:asserted_by a owl:ObjectProperty ;
    rdfs:label "is asserted by" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A claim, verdict, title or saying is vouched for by a named party, or by the writing itself where no speaker is named; it lets two differing claims be held side by side without being joined." ;
    bor:category "Language" ;
    bor:inverseLabel "asserts" ;
    bor:sourceKind "assessment",
        "concept",
        "image",
        "pattern",
        "text",
        "title" ;
    bor:targetKind "being",
        "concept",
        "creature",
        "group",
        "person",
        "text" .

bor:assessed_as a owl:ObjectProperty ;
    rdfs:label "did" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A subject is the doer of a deed that the text itself evaluates, such as the verdict pronounced on a reign or on a part of creation; the evaluation is the text's own and not a reader's." ;
    bor:category "Verdicts" ;
    bor:inverseLabel "was done by" ;
    bor:sourceKind "being",
        "concept",
        "covenant",
        "creature",
        "group",
        "object",
        "person",
        "place",
        "text" ;
    bor:targetKind "assessment",
        "concept",
        "pattern" .

bor:assumed_form_of a owl:ObjectProperty ;
    rdfs:label "was a form assumed by" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A temporary form is the form that a person or being took on and later set aside, where the text narrates the taking; the form is the source and the one who took it is the target." ;
    bor:category "Encounters & speech" ;
    bor:inverseLabel "took the form of" ;
    bor:sourceKind "being",
        "creature",
        "group",
        "object",
        "person" ;
    bor:targetKind "being",
        "person" .

bor:ate a owl:ObjectProperty ;
    rdfs:label "ate" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, being, group or creature eats something, where the text records the eating." ;
    bor:category "Encounters & speech" ;
    bor:inverseLabel "was eaten by" ;
    bor:sourceKind "being",
        "creature",
        "group",
        "object",
        "person" ;
    bor:targetKind "concept",
        "creature",
        "image",
        "object",
        "place" .

bor:attacked a owl:ObjectProperty ;
    rdfs:label "attacked / made war on" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, group or being attacks or makes war on a person or group." ;
    bor:category "Conflict" ;
    bor:inverseLabel "was attacked by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:baptized a owl:ObjectProperty ;
    rdfs:label "baptized" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or being baptizes a person or group." ;
    bor:category "Prophetic & priestly" ;
    bor:inverseLabel "was baptized by" ;
    bor:sourceKind "being",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:based_at a owl:ObjectProperty ;
    rdfs:label "centred on" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A group is centred on a place, so that a church, household or tribe is a group with a location and not a synonym for the place." ;
    bor:category "Places" ;
    bor:inverseLabel "was the centre of" ;
    bor:sourceKind "group" ;
    bor:targetKind "place" .

bor:besought a owl:ObjectProperty ;
    rdfs:label "pleaded with" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group entreats another where the text marks the act as a petition; the polite \"please\" of ordinary speech is not recorded." ;
    bor:category "Encounters & speech" ;
    bor:inverseLabel "was pleaded with by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "being",
        "group",
        "person" .

bor:betrayed a owl:ObjectProperty ;
    rdfs:label "betrayed" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group betrays another person or group." ;
    bor:category "Conflict" ;
    bor:inverseLabel "was betrayed by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:betrothed_to a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is betrothed to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "Two people are betrothed to each other before marriage; the relation reads the same from either side." ;
    bor:category "Marriage & union" .

bor:blessed a owl:ObjectProperty ;
    rdfs:label "blessed" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A being, person or group pronounces a formal and consequential blessing on a person or group, not a casual greeting." ;
    bor:category "Prophetic & priestly" ;
    bor:inverseLabel "was blessed by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:born_at a owl:ObjectProperty ;
    rdfs:label "was born at" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person was born at a place, recorded only where the text says born and not merely present." ;
    bor:category "Places" ;
    bor:inverseLabel "was the birthplace of" ;
    bor:sourceKind "person" ;
    bor:targetKind "place" .

bor:bought a owl:ObjectProperty ;
    rdfs:label "bought" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group buys a place, object or thing, in a purchase the text records." ;
    bor:category "Places" ;
    bor:inverseLabel "was bought by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "concept",
        "object",
        "place" .

bor:built a owl:ObjectProperty ;
    rdfs:label "built" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, group or being raises a place or structure, where the text says who built it." ;
    bor:category "Places" ;
    bor:inverseLabel "was built by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "object",
        "place" .

bor:buried_at a owl:ObjectProperty ;
    rdfs:label "was buried at" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person was buried at a place or object." ;
    bor:category "Places" ;
    bor:inverseLabel "is the burial place of" ;
    bor:sourceKind "person" ;
    bor:targetKind "object",
        "place" .

bor:came_upon a owl:ObjectProperty ;
    rdfs:label "came upon" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "The Spirit or another being comes upon a person or group, as the text puts it; the edge says the verse reports this and does not say what the coming produced or how long it lasted." ;
    bor:category "Prophetic & priestly" ;
    bor:inverseLabel "had the Spirit come upon them" ;
    bor:sourceKind "being" ;
    bor:targetKind "group",
        "person" .

bor:carried a owl:ObjectProperty ;
    rdfs:label "carried" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group bears or transports an object, concept or creature." ;
    bor:category "Things" ;
    bor:inverseLabel "was carried by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "concept",
        "creature",
        "object" .

bor:cast_into a owl:ObjectProperty ;
    rdfs:label "was cast into" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group is put into a place or object against their will and kept there; the source is the one who ends up inside and not the one who threw them." ;
    bor:category "Conflict" ;
    bor:inverseLabel "held" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "object",
        "place" .

bor:category a owl:AnnotationProperty ;
    rdfs:label "the group a relation belongs to" .

bor:charged a owl:ObjectProperty ;
    rdfs:label "charged" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, being or group lays a binding instruction on another, stronger than a request." ;
    bor:category "Service & authority" ;
    bor:inverseLabel "was charged by" ;
    bor:sourceKind "being",
        "group",
        "person",
        "title" ;
    bor:targetKind "concept",
        "group",
        "person" .

bor:co_regent_with a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "reigned jointly with" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "Two people reigned jointly; the relation reads the same from either side." ;
    bor:category "Rule & succession" .

bor:commanded_the_making_of a owl:ObjectProperty ;
    rdfs:label "commanded the making of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or being commands that something be made, which is kept apart from the one who does the making." ;
    bor:category "Things" ;
    bor:inverseLabel "was commanded by" ;
    bor:sourceKind "being",
        "person" ;
    bor:targetKind "object" .

bor:commander_of a owl:ObjectProperty ;
    rdfs:label "commanded the army of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person commanded the army of another." ;
    bor:category "Service & authority" ;
    bor:inverseLabel "had as army commander" .

bor:companion_of a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "traveled / worked with" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "Two people travelled or worked together; the relation reads the same from either side." ;
    bor:category "Association" .

bor:composed_of a owl:ObjectProperty ;
    rdfs:label "is built from the words" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A phrase is built from the words of a term; this is a fact about the wording only and does not say that the phrase is a kind of that thing." ;
    bor:category "Language" ;
    bor:inverseLabel "appears in the phrase" ;
    bor:sourceKind "assessment",
        "being",
        "concept",
        "covenant",
        "creature",
        "group",
        "image",
        "object",
        "observance",
        "person",
        "place",
        "text",
        "title" ;
    bor:targetKind "assessment",
        "being",
        "concept",
        "covenant",
        "creature",
        "group",
        "image",
        "object",
        "observance",
        "person",
        "place",
        "text",
        "title" .

bor:concubine_of a owl:ObjectProperty ;
    rdfs:label "is a concubine of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A woman is a concubine of a man, a status the text distinguishes from marriage; the concubine is the source and the man the target." ;
    bor:category "Marriage & union" ;
    bor:inverseLabel "had as concubine" .

bor:conditional_on a owl:ObjectProperty ;
    rdfs:label "is conditional on" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A consequence the text states is tied to the condition on which it depends, as in a bargain, a blessing or a warning that begins \"if\"." ;
    bor:category "Language" ;
    bor:inverseLabel "is the condition for" ;
    bor:sourceKind "assessment",
        "concept",
        "covenant",
        "image",
        "text",
        "title" ;
    bor:targetKind "assessment",
        "concept",
        "covenant",
        "image",
        "text",
        "title" .

bor:conquered a owl:ObjectProperty ;
    rdfs:label "conquered" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or group subjugated another with a lasting outcome, as distinct from a single battle." ;
    bor:category "Peoples & groups" ;
    bor:inverseLabel "was conquered by" ;
    bor:sourceKind "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:conspired_against a owl:ObjectProperty ;
    rdfs:label "conspired against" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, group or being plots against a person or group." ;
    bor:category "Conflict" ;
    bor:inverseLabel "was the target of a conspiracy by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "group",
        "person" .

bor:contrary_to a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is contrary to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "The text sets two things against each other, by saying they are contrary or by building the contrast into its structure; the opposition is the text's and not a reader's, and tensions the text leaves standing are not recorded." ;
    bor:category "What the text sets against it" ;
    bor:sourceKind "assessment",
        "being",
        "concept",
        "image",
        "text",
        "title" ;
    bor:targetKind "assessment",
        "being",
        "concept",
        "image",
        "text",
        "title" .

bor:counselor_of a owl:ObjectProperty ;
    rdfs:label "was counselor to" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person advised another." ;
    bor:category "Service & authority" ;
    bor:inverseLabel "was counseled by" .

bor:cousin_of a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is the cousin of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "Two people are cousins, recorded only where the text itself says so; the relation reads the same from either side." ;
    bor:category "Kinship" ;
    bor:sourceKind "person" ;
    bor:targetKind "person" .

bor:cursed a owl:ObjectProperty ;
    rdfs:label "pronounced a curse on" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person or being pronounces a curse on a person, group, place, creature, object or being." ;
    bor:category "Prophetic & priestly" ;
    bor:inverseLabel "was cursed by" ;
    bor:sourceKind "being",
        "person" ;
    bor:targetKind "being",
        "creature",
        "group",
        "object",
        "person",
        "place" .

bor:deceived a owl:ObjectProperty ;
    rdfs:label "deceived" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, group, being or creature deceives a person, group or being." ;
    bor:category "Conflict" ;
    bor:inverseLabel "was deceived by" ;
    bor:sourceKind "being",
        "creature",
        "group",
        "person" ;
    bor:targetKind "being",
        "group",
        "person" .

bor:deity_of a owl:ObjectProperty ;
    rdfs:label "is the God of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A divine being is called the God of a person or people, as in the text's formula \"the God of\" a patriarch or of Israel; it is a relationship the text states and not an identification of the two." ;
    bor:category "Father, Son & Spirit" ;
    bor:inverseLabel "whose God he is called" ;
    bor:sourceKind "being" ;
    bor:targetKind "group",
        "person" .

bor:deposed a owl:ObjectProperty ;
    rdfs:label "deposed / removed from power" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person is removed from power by another." ;
    bor:category "Rule & succession" ;
    bor:inverseLabel "was deposed by" .

bor:descended_from_person a owl:ObjectProperty ;
    rdfs:label "descends from" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A tribe or nation descends from the person it is named for, as the text explains the origin of a people; the person and the people remain separate nodes." ;
    bor:category "Peoples & groups" ;
    bor:inverseLabel "is the ancestor of" ;
    bor:sourceKind "group" ;
    bor:targetKind "person" .

bor:described_as a owl:ObjectProperty ;
    rdfs:label "is described as" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A subject is said by the text to be a certain way: an age, a state, a trait, a role or a verdict on the subject itself, as distinct from a deed that is evaluated." ;
    bor:category "Verdicts" ;
    bor:inverseLabel "is said of" ;
    bor:sourceKind "being",
        "concept",
        "covenant",
        "creature",
        "group",
        "object",
        "person",
        "place",
        "text" ;
    bor:targetKind "assessment",
        "concept",
        "pattern" .

bor:destroyed a owl:ObjectProperty ;
    rdfs:label "destroyed" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person, being or group destroys a place, people, thing or creature, where the text says so." ;
    bor:category "Conflict" ;
    bor:inverseLabel "was destroyed by" ;
    bor:sourceKind "being",
        "group",
        "person" ;
    bor:targetKind "concept",
        "creature",
        "group",
        "object",
        "person",
        "place" .

bor:died_at a owl:ObjectProperty ;
    rdfs:label "died at" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A person died at a place." ;
    bor:category "Places" ;
    bor:inverseLabel "was where they died" ;
    bor:sourceKind "person" ;
    bor:targetKind "place" .

bor:distinguished_from a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is distinguished from" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "The text sets the two apart, for example when a speaker contrasts himself with another; it records the statement and does not settle what the contrast means." ;
    bor:category "Father, Son & Spirit" ;
    bor:sourceKind "being",
        "person" ;
    bor:targetKind "being",
        "person" .

bor:drawn_from a owl:ObjectProperty ;
    rdfs:label "is drawn from" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A word used as an image is joined to the tangible thing of the same name, where the graph holds one; the two share a word and are not one node." ;
    bor:category "Images & figures" ;
    bor:inverseLabel "is used as an image" ;
    bor:sourceKind "image" ;
    bor:targetKind "creature",
        "event",
        "group",
        "object",
        "observance",
        "person",
        "place" .

bor:draws_on a owl:ObjectProperty ;
    rdfs:label "draws on the image of" ;
    rdfs:isDefinedBy <https://bibleontology.org/ns/relation> ;
    skos:definition "A title, saying or image is built on another image, person, place, being or text; this is a claim about wording and not about what the image means." ;
    bor:category "Images & figures" ;
    bor:inverseLabel "is the image behind" ;
    bor:sourceKind "image",
        "text",
        "title" ;
    bor:targetKind "being",
        "covenant",
        "creature",
        "group",
        "image",
        "object",
        "observance",
        "person",
        "place",
        "text",
        "title" .

