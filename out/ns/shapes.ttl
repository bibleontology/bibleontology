# Bible Ontology -- SHACL shapes, version 1.2.1 (2026-10-22).
# Closed-world checks for the graph: what the vocabularies at /ns/meaning, /ns/structure
# and /ns/relation describe, checked here rather than inferred. Run with inference off.
# (c) 2026 Doug Egge. Licensed under CC BY 4.0: share and adapt, with credit to Bible Ontology by Doug Egge (bibleontology.org).
# Licence: https://creativecommons.org/licenses/by/4.0/
@prefix bom: <https://bibleontology.org/ns/meaning#> .
@prefix bor: <https://bibleontology.org/ns/relation#> .
@prefix bos: <https://bibleontology.org/ns/structure#> .
@prefix bosh: <https://bibleontology.org/ns/meaning/shapes#> .
@prefix bow: <https://bibleontology.org/ns/word#> .
@prefix claim: <https://bibleontology.org/ns/claim#> .
@prefix csh: <https://bibleontology.org/ns/claim/shapes#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

csh:ClaimShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A claim has exactly one subject." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:subject ],
        [ sh:maxCount 1 ;
            sh:message "A claim names the voice its triple is stated in." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:voice ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path claim:readBy ],
        [ sh:maxCount 1 ;
            sh:message "A claim has exactly one relation, from /ns/relation, or claim:says for a reporting speaker's claim." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:relation ;
            sh:pattern "^https://bibleontology.org/ns/(relation#|claim#says$)" ],
        [ sh:maxCount 1 ;
            sh:message "A claim has exactly one object." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:object ],
        [ sh:message "A claim rests on at least one verse, each the site's page for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path claim:verse ;
            sh:pattern "^https://bibleontology.org/p/[0-9A-Za-z]+\\.[0-9]+\\.[0-9]+$" ],
        [ sh:in ( claim:explicit claim:implied claim:conjectured claim:disputed ) ;
            sh:maxCount 1 ;
            sh:message "A claim carries one step of the certainty scale." ;
            sh:minCount 1 ;
            sh:path claim:certainty ] ;
    sh:targetClass claim:Claim .

csh:StatementShape a sh:NodeShape ;
    sh:property [ sh:in ( claim:modality_stated claim:modality_nonfinite claim:modality_commanded claim:modality_commanded_or_wished claim:modality_promised claim:modality_foretold claim:modality_urged claim:modality_wished claim:modality_asked ) ;
            sh:maxCount 1 ;
            sh:message "A verb statement carries one force from the modalities scheme." ;
            sh:minCount 1 ;
            sh:path claim:modality ],
        [ sh:in ( claim:family_verb_body claim:family_verb_change claim:family_verb_cognition claim:family_verb_communication claim:family_verb_competition claim:family_verb_consumption claim:family_verb_contact claim:family_verb_creation claim:family_verb_emotion claim:family_verb_motion claim:family_verb_perception claim:family_verb_possession claim:family_verb_social claim:family_verb_stative claim:family_verb_weather ) ;
            sh:maxCount 1 ;
            sh:message "A verb statement's family, where it has one, is from the verb families scheme." ;
            sh:path claim:family ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "A verb statement says whether its clause is negated." ;
            sh:minCount 1 ;
            sh:path claim:negated ],
        [ sh:maxCount 1 ;
            sh:message "A verb statement's verb is a word page." ;
            sh:nodeKind sh:IRI ;
            sh:path claim:verb ;
            sh:pattern "^https://bibleontology.org/word/[hg][0-9]+$" ],
        [ sh:message "A clause is addressed by its verse, in the verse pages' book codes, and its id within the verse." ;
            sh:nodeKind sh:IRI ;
            sh:path claim:clause ;
            sh:pattern "^https://bibleontology.org/structure/(Gen|Exod|Lev|Num|Deut|Josh|Judg|Ruth|1Sam|2Sam|1Kgs|2Kgs|1Chr|2Chr|Ezra|Neh|Esth|Job|Ps|Prov|Eccl|Song|Isa|Jer|Lam|Ezek|Dan|Hos|Joel|Amos|Obad|Jonah|Mic|Nah|Hab|Zeph|Hag|Zech|Mal|Matt|Mark|Luke|John|Acts|Rom|1Cor|2Cor|Gal|Eph|Phil|Col|1Thess|2Thess|1Tim|2Tim|Titus|Phlm|Heb|Jas|1Pet|2Pet|1John|2John|3John|Jude|Rev)\\.[0-9]+\\.[0-9]+#[a-z]+[0-9]+$" ] ;
    sh:targetSubjectsOf claim:verbLabel .

bosh:Classification a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:classifies ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:inClass ],
        [ sh:minCount 1 ;
            sh:path bom:statement ],
        [ sh:minCount 1 ;
            sh:path bom:saidBy ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:Classification .

bosh:ContestedHasBothSides a sh:NodeShape ;
    sh:sparql [ sh:message "A use the text itself settles (a figure with a stated tenor) is not contested." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            SELECT $this WHERE {
                $this bom:usage bom:Contested .
                ?f bom:figureAt $this ; bom:tenorBasis "stated" .
            }""" ],
        [ sh:message "A contested use needs at least two usage readings that answer differently." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            SELECT $this WHERE {
                $this bom:usage bom:Contested .
                FILTER NOT EXISTS {
                    ?a bom:readsUsageOf $this ; bom:readsUsage ?ua .
                    ?b bom:readsUsageOf $this ; bom:readsUsage ?ub .
                    FILTER (?ua != ?ub)
                }
            }""" ] ;
    sh:targetClass bow:Occurrence .

bosh:FigurativeHasFigure a sh:NodeShape ;
    sh:sparql [ sh:message "Usage is figurative (or a sign), but no FigurativeUse is at this occurrence." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            SELECT $this WHERE {
                $this bom:usage ?u .
                FILTER (?u IN (bom:Figurative, bom:Sign))
                FILTER NOT EXISTS { ?f bom:figureAt $this }
            }""" ] ;
    sh:targetClass bow:Occurrence .

bosh:FigurativeUse a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:figureAt ],
        [ sh:class bow:Sense ;
            sh:maxCount 1 ;
            sh:message "A figure names its image (the vehicle) as a sense." ;
            sh:minCount 1 ;
            sh:path bom:vehicle ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:mode ],
        [ sh:message "A figure says what in the text marks it." ;
            sh:minCount 1 ;
            sh:path bom:marker ],
        [ sh:in ( "stated" "read" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:tenorBasis ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:FigurativeUse .

bosh:MembershipIsArgued a sh:NodeShape ;
    sh:sparql [ sh:message "A member of Human, Deity, HeavenlyBeing or Spirit with no Classification citing why." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            SELECT $this ?c WHERE {
                $this a ?c .
                FILTER (?c IN (bom:Human, bom:Deity, bom:HeavenlyBeing, bom:Spirit))
                FILTER NOT EXISTS {
                    ?k bom:classifies $this ; bom:inClass ?c ; bom:evidence ?v .
                }
            }""" ] ;
    sh:targetClass bom:Individual .

bosh:Occurrence a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An occurrence has exactly one lexeme." ;
            sh:minCount 1 ;
            sh:path bow:ofLexeme ],
        [ sh:maxCount 1 ;
            sh:message "An occurrence carries at most one sense (or none, where the evidence does not decide)." ;
            sh:path bow:inSense ],
        [ sh:in ( bom:Literal bom:Figurative bom:Unmarked bom:Sign bom:Contested ) ;
            sh:maxCount 1 ;
            sh:message "Usage is literal, figurative, a sign, contested, or unmarked — one of them." ;
            sh:path bom:usage ] ;
    sh:targetClass bow:Occurrence .

bosh:OneTopClass a sh:NodeShape ;
    sh:sparql [ sh:message "An individual carries more than one top class; keep the least disputed and move the rest to predications." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this WHERE {
                $this a ?c1, ?c2 .
                FILTER (?c1 != ?c2)
                FILTER (?c1 IN (bom:PersonalBeing, bom:Group, bom:Animal,
                    bom:Plant, bom:Artifact, bom:BodyPart, bom:Food,
                    bom:Substance, bom:NaturalObject, bom:Place, bom:Time,
                    bom:Event, bom:Act, bom:State, bom:Phenomenon,
                    bom:Feeling, bom:Cognition, bom:Communication,
                    bom:Attribute, bom:Quantity, bom:Possession,
                    bom:Relation, bom:Shape, bom:Motive))
                FILTER (?c2 IN (bom:PersonalBeing, bom:Group, bom:Animal,
                    bom:Plant, bom:Artifact, bom:BodyPart, bom:Food,
                    bom:Substance, bom:NaturalObject, bom:Place, bom:Time,
                    bom:Event, bom:Act, bom:State, bom:Phenomenon,
                    bom:Feeling, bom:Cognition, bom:Communication,
                    bom:Attribute, bom:Quantity, bom:Possession,
                    bom:Relation, bom:Shape, bom:Motive))
            }""" ] ;
    sh:targetClass bom:Individual .

bosh:Predication a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path bom:predicatedCategory ] [ sh:minCount 1 ;
                sh:path bom:predicatedIdentity ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:predicationOf ],
        [ sh:message "The saying is the fact: a predication names who says it." ;
            sh:minCount 1 ;
            sh:path bom:saidBy ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:Predication .

bosh:Reading a sh:NodeShape ;
    sh:property [ sh:message "A reading always names its reader." ;
            sh:minCount 1 ;
            sh:path prov:wasAttributedTo ],
        [ sh:minCount 1 ;
            sh:path bom:evidence ] ;
    sh:targetClass bom:Reading .

bosh:SenseProvenance a sh:NodeShape ;
    sh:property [ sh:message "A sense says how it was reached ('English' via a gloss)." ;
            sh:minCount 1 ;
            sh:path bom:derivedVia ] ;
    sh:targetClass bow:Sense .

bosh:ShownCardWord a sh:NodeShape ;
    sh:property [ sh:hasValue bom:default ;
            sh:message "A shown card word is shown by default under the filter policy." ;
            sh:path bom:tier ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "An anchored word under the policy's cut (0.15) is shown." ;
            sh:prefixes [ sh:declare [ sh:namespace "https://bibleontology.org/ns/meaning#"^^xsd:anyURI ;
                            sh:prefix "bom" ],
                        [ sh:namespace "http://www.w3.org/ns/dqv#"^^xsd:anyURI ;
                            sh:prefix "dqv" ] ] ;
            sh:select """SELECT $this WHERE { $this bom:wordBasis "anchored" ;
            dqv:hasQualityMeasurement [ dqv:isMeasurementOf bom:cardWordShare ; dqv:value ?v ] .
            FILTER (?v < 0.15) }""" ] ;
    sh:targetClass bom:CardWord .

bosh:SignIsStated a sh:NodeShape ;
    sh:sparql [ sh:message "A sign whose meaning is not stated by the text is a reading, not a sign." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            SELECT $this WHERE {
                $this bom:usage bom:Sign .
                FILTER NOT EXISTS { ?f bom:figureAt $this ; bom:tenorBasis "stated" }
            }""" ] ;
    sh:targetClass bow:Occurrence .

bosh:TenorFollowsBasis a sh:NodeShape ;
    sh:sparql [ sh:message "A figure whose tenor is 'read' carries the tenor itself; it must be on a SymbolReading with a named reader." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            SELECT $this WHERE { $this bom:tenorBasis "read" ; bom:tenor ?t . }""" ],
        [ sh:message "A figure whose tenor is 'stated' names it." ;
            sh:select """
            PREFIX bom: <https://bibleontology.org/ns/meaning#>
            SELECT $this WHERE { $this bom:tenorBasis "stated" .
                                 FILTER NOT EXISTS { $this bom:tenor ?t } }""" ] ;
    sh:targetClass bom:FigurativeUse .

bosh:UsageReading a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:readsUsageOf ],
        [ sh:in ( bom:Literal bom:Figurative bom:Sign ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bom:readsUsage ],
        [ sh:minCount 1 ;
            sh:path bom:readsAs ] ;
    sh:targetClass bom:UsageReading .

bor:accused_objectShape a sh:NodeShape ;
    sh:message "The object of accused must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:accused .

bor:accused_subjectShape a sh:NodeShape ;
    sh:message "The subject of accused must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:accused .

bor:ancestor_of_objectShape a sh:NodeShape ;
    sh:message "The object of ancestor_of must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:ancestor_of .

bor:ancestor_of_subjectShape a sh:NodeShape ;
    sh:message "The subject of ancestor_of must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:ancestor_of .

bor:anointed_subjectShape a sh:NodeShape ;
    sh:message "The subject of anointed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:anointed .

bor:answered_objectShape a sh:NodeShape ;
    sh:message "The object of answered must be one of: Animal, Group, PersonalBeing, Saying" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Saying ] ) ;
    sh:targetObjectsOf bor:answered .

bor:answered_subjectShape a sh:NodeShape ;
    sh:message "The subject of answered must be one of: Group, PersonalBeing, Saying" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Saying ] ) ;
    sh:targetSubjectsOf bor:answered .

bor:appeared_to_objectShape a sh:NodeShape ;
    sh:message "The object of appeared_to must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:appeared_to .

bor:appeared_to_subjectShape a sh:NodeShape ;
    sh:message "The subject of appeared_to must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:appeared_to .

bor:appointed_objectShape a sh:NodeShape ;
    sh:message "The object of appointed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:appointed .

bor:appointed_subjectShape a sh:NodeShape ;
    sh:message "The subject of appointed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:appointed .

bor:ascribed_to_objectShape a sh:NodeShape ;
    sh:message "The object of ascribed_to must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:ascribed_to .

bor:aspect_of_objectShape a sh:NodeShape ;
    sh:message "The object of aspect_of must be one of: Artifact, Communication, Concept, Event, Group, Image, PersonalBeing, Place, Title" ;
    sh:or ( [ sh:class bom:Artifact ] [ sh:class bom:Communication ] [ sh:class bom:Concept ] [ sh:class bom:Event ] [ sh:class bom:Group ] [ sh:class bom:Image ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Place ] [ sh:class bom:Title ] ) ;
    sh:targetObjectsOf bor:aspect_of .

bor:asserted_by_objectShape a sh:NodeShape ;
    sh:message "The object of asserted_by must be one of: Animal, Concept, Group, PersonalBeing, Saying" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Concept ] [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Saying ] ) ;
    sh:targetObjectsOf bor:asserted_by .

bor:assessed_as_subjectShape a sh:NodeShape ;
    sh:message "The subject of assessed_as must be one of: Animal, Artifact, Communication, Concept, Group, PersonalBeing, Place, Saying" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Artifact ] [ sh:class bom:Communication ] [ sh:class bom:Concept ] [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Place ] [ sh:class bom:Saying ] ) ;
    sh:targetSubjectsOf bor:assessed_as .

bor:assumed_form_of_subjectShape a sh:NodeShape ;
    sh:message "The subject of assumed_form_of must be one of: Animal, Artifact, Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Artifact ] [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:assumed_form_of .

bor:ate_objectShape a sh:NodeShape ;
    sh:message "The object of ate must be one of: Animal, Artifact, Concept, Image, Place" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Artifact ] [ sh:class bom:Concept ] [ sh:class bom:Image ] [ sh:class bom:Place ] ) ;
    sh:targetObjectsOf bor:ate .

bor:ate_subjectShape a sh:NodeShape ;
    sh:message "The subject of ate must be one of: Animal, Artifact, Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Artifact ] [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:ate .

bor:attacked_objectShape a sh:NodeShape ;
    sh:message "The object of attacked must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:attacked .

bor:attacked_subjectShape a sh:NodeShape ;
    sh:message "The subject of attacked must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:attacked .

bor:baptized_objectShape a sh:NodeShape ;
    sh:message "The object of baptized must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:baptized .

bor:besought_objectShape a sh:NodeShape ;
    sh:message "The object of besought must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:besought .

bor:besought_subjectShape a sh:NodeShape ;
    sh:message "The subject of besought must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:besought .

bor:betrayed_objectShape a sh:NodeShape ;
    sh:message "The object of betrayed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:betrayed .

bor:betrayed_subjectShape a sh:NodeShape ;
    sh:message "The subject of betrayed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:betrayed .

bor:blessed_objectShape a sh:NodeShape ;
    sh:message "The object of blessed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:blessed .

bor:blessed_subjectShape a sh:NodeShape ;
    sh:message "The subject of blessed must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:blessed .

bor:bought_objectShape a sh:NodeShape ;
    sh:message "The object of bought must be one of: Artifact, Concept, Place" ;
    sh:or ( [ sh:class bom:Artifact ] [ sh:class bom:Concept ] [ sh:class bom:Place ] ) ;
    sh:targetObjectsOf bor:bought .

bor:bought_subjectShape a sh:NodeShape ;
    sh:message "The subject of bought must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:bought .

bor:built_objectShape a sh:NodeShape ;
    sh:message "The object of built must be one of: Artifact, Place" ;
    sh:or ( [ sh:class bom:Artifact ] [ sh:class bom:Place ] ) ;
    sh:targetObjectsOf bor:built .

bor:built_subjectShape a sh:NodeShape ;
    sh:message "The subject of built must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:built .

bor:buried_at_objectShape a sh:NodeShape ;
    sh:message "The object of buried_at must be one of: Artifact, Place" ;
    sh:or ( [ sh:class bom:Artifact ] [ sh:class bom:Place ] ) ;
    sh:targetObjectsOf bor:buried_at .

bor:came_upon_objectShape a sh:NodeShape ;
    sh:message "The object of came_upon must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:came_upon .

bor:carried_objectShape a sh:NodeShape ;
    sh:message "The object of carried must be one of: Animal, Artifact, Concept" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Artifact ] [ sh:class bom:Concept ] ) ;
    sh:targetObjectsOf bor:carried .

bor:carried_subjectShape a sh:NodeShape ;
    sh:message "The subject of carried must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:carried .

bor:cast_into_objectShape a sh:NodeShape ;
    sh:message "The object of cast_into must be one of: Artifact, Place" ;
    sh:or ( [ sh:class bom:Artifact ] [ sh:class bom:Place ] ) ;
    sh:targetObjectsOf bor:cast_into .

bor:cast_into_subjectShape a sh:NodeShape ;
    sh:message "The subject of cast_into must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:cast_into .

bor:charged_objectShape a sh:NodeShape ;
    sh:message "The object of charged must be one of: Concept, Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Concept ] [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:charged .

bor:charged_subjectShape a sh:NodeShape ;
    sh:message "The subject of charged must be one of: Group, PersonalBeing, Title" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Title ] ) ;
    sh:targetSubjectsOf bor:charged .

bor:composed_of_objectShape a sh:NodeShape ;
    sh:message "The object of composed_of must be one of: Animal, Artifact, Communication, Concept, Event, Group, Image, PersonalBeing, Place, Predication, Saying, Title" ;
    sh:or ( [ sh:class bom:Animal ] [ sh:class bom:Artifact ] [ sh:class bom:Communication ] [ sh:class bom:Concept ] [ sh:class bom:Event ] [ sh:class bom:Group ] [ sh:class bom:Image ] [ sh:class bom:PersonalBeing ] [ sh:class bom:Place ] [ sh:class bom:Predication ] [ sh:class bom:Saying ] [ sh:class bom:Title ] ) ;
    sh:targetObjectsOf bor:composed_of .

bor:composed_of_subjectShape a sh:NodeShape ;
