@prefix sh: <http://www.w3.org/ns/shacl#> .

bor:accused_objectShape a sh:NodeShape ;
    sh:message "The object of accused must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetObjectsOf bor:accused .

bor:accused_subjectShape a sh:NodeShape ;
    sh:message "The subject of accused must be one of: Group, PersonalBeing" ;
    sh:or ( [ sh:class bom:Group ] [ sh:class bom:PersonalBeing ] ) ;
    sh:targetSubjectsOf bor:accused .

